AUTH_MODE=oidc
REQUIRE_AUTHENTICATION=true
ENABLE_BACKEND_ACCESS_CONTROL=true
AUTH_TOKEN_COOKIE_SECURE=true
OIDC_AUDIENCES=cognee,https://cognee-mcp.int.aslamel.net/mcp
